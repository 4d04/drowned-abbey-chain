{
  "name": "@abbey/rules",
  "version": "0.1.0",
  "private": true,
  "description": "Deterministic rules engine and content packs for The Drowned Abbey (shared by plugin and client)",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "import": "./dist/src/index.js",
      "default": "./src/index.ts"
    }
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "test": "node --test --test-reporter=spec 'test/**/*.test.ts'",
    "lint:content": "node scripts/lint.ts",
    "sim": "node scripts/sim.ts",
    "fixtures": "node scripts/fixtures.ts",
    "build": "tsc -p tsconfig.build.json",
    "check": "npm run typecheck && npm test && npm run lint:content && TARGETS=1 npm run sim"
  },
  "dependencies": {
    "@noble/hashes": "2.0.1"
  },
  "devDependencies": {
    "@types/node": "24.10.1",
    "typescript": "5.9.3"
  },
  "engines": {
    "node": ">=23.6.0"
  }
}
