{
  "id": 1,
  "key": "drowned-abbey",
  "version": 1,
  "budget": 700,
  "entry": 1,
  "camp": 0,
  "bossRoom": 12,
  "season": { "capSeconds": 300000, "resetAfterBossSeconds": 1800, "bellWarningSeconds": 600 },
  "wandering": ["giant_rat", "skeleton"],
  "rooms": [
    { "id": 0, "key": "lychgate", "camp": true },
    { "id": 1, "key": "narthex", "pools": ["silt"] },
    { "id": 2, "key": "ossuary", "monsters": [{ "template": "skeleton" }, { "template": "skeleton" }, { "template": "skeleton" }] },
    { "id": 3, "key": "chapel", "pools": ["altar"] },
    { "id": 4, "key": "scriptorium" },
    { "id": 5, "key": "cloister", "monsters": [{ "template": "giant_rat" }, { "template": "giant_rat" }] },
    { "id": 6, "key": "bell_stair" },
    { "id": 7, "key": "reliquary", "monsters": [{ "template": "mimic", "status": "disguised" }],
      "onCleared": [{ "op": "grantLoot", "table": "mimic_hoard" }] },
    { "id": 8, "key": "kitchens", "monsters": [{ "template": "goblin", "status": "wary" }, { "template": "goblin", "status": "wary" }, { "template": "goblin", "status": "wary" }],
      "onCleared": [{ "op": "grantLoot", "table": "goblin_purse" }] },
    { "id": 9, "key": "cistern_bridge" },
    { "id": 10, "key": "sacristy" },
    { "id": 11, "key": "drowned_choir", "monsters": [{ "template": "ghoul" }, { "template": "ghoul" }],
      "onCleared": [{ "op": "grantLoot", "table": "choir_relic" }] },
    { "id": 12, "key": "sepulchre", "monsters": [{ "template": "drowned_abbot" }],
      "onCleared": [{ "op": "grantLoot", "table": "abbot_hoard", "to": "pile" }, { "op": "narrate", "outcome": "abbot_falls" }] }
  ],
  "edges": [
    { "from": 0, "to": 1, "oneWay": true },
    { "from": 1, "to": 2 },
    { "from": 1, "to": 3 },
    { "from": 2, "to": 4 },
    { "from": 2, "to": 5 },
    { "from": 3, "to": 6 },
    { "from": 5, "to": 8, "requires": [{ "roomCounter": "rubble", "atLeast": 2 }] },
    { "from": 6, "to": 7, "requires": [{ "any": [{ "roomFlag": "trap_disarmed" }, { "roomFlag": "trap_triggered" }] }] },
    { "from": 7, "to": 8 },
    { "from": 7, "to": 9 },
    { "from": 7, "to": 10, "hidden": true },
    { "from": 9, "to": 11, "requires": [{ "roomFlag": "rope_tied" }] },
    { "from": 11, "to": 12 },
    { "from": 12, "to": { "level": 2, "room": 0 }, "requires": [{ "levelBossDefeated": 1 }] }
  ],
  "lootTables": {
    "silt_purse":        { "gold": "15", "once": true },
    "scriptorium_chest": { "gold": "40", "items": ["silvered_dagger"], "once": true },
    "mimic_hoard":       { "gold": "60", "once": true },
    "goblin_purse":      { "gold": "2d6", "once": true },
    "sacristy_hoard":    { "gold": "120", "items": ["abbots_signet"], "once": true },
    "abbot_hoard":       { "gold": "300", "items": ["abbots_crozier"], "once": true },
    "chapel_ward":       { "items": ["saints_ward"], "once": true },
    "choir_relic":       { "items": ["saints_ward"], "once": true }
  },
  "actions": [
    { "id": "narthex.wade_out", "room": 1, "provokes": false,
      "check": { "ability": "DEX", "dc": 10 },
      "onSuccess": [{ "op": "moveTo", "room": 0 }],
      "onFailure": [{ "op": "dropGold", "dice": "1d4", "pool": "silt" }, { "op": "narrate", "outcome": "gold_lost_in_silt" }, { "op": "moveTo", "room": 0 }] },
    { "id": "narthex.search_silt", "room": 1,
      "check": { "ability": "WIS", "dc": 12 },
      "onSuccess": [{ "op": "claimPool", "pool": "silt" }, { "op": "grantLoot", "table": "silt_purse" }],
      "onFailure": [{ "op": "narrate", "outcome": "only_mud" }] },

    { "id": "ossuary.sneak_scriptorium", "room": 2, "provokes": "onFailure",
      "when": [{ "monstersAlive": true }],
      "check": { "ability": "DEX", "dc": 14, "disadvantage": true },
      "onSuccess": [{ "op": "moveTo", "room": 4 }],
      "onFailure": [{ "op": "narrate", "outcome": "bones_clatter" }] },
    { "id": "ossuary.sneak_cloister", "room": 2, "provokes": "onFailure",
      "when": [{ "monstersAlive": true }],
      "check": { "ability": "DEX", "dc": 14, "disadvantage": true },
      "onSuccess": [{ "op": "moveTo", "room": 5 }],
      "onFailure": [{ "op": "narrate", "outcome": "bones_clatter" }] },

    { "id": "chapel.pray", "room": 3,
      "check": { "ability": "WIS", "dc": 13 },
      "onSuccess": [{ "op": "applyStatus", "status": "blessed" }],
      "onFailure": [{ "op": "applyStatus", "status": "chilled" }] },
    { "id": "chapel.offer", "room": 3,
      "when": [{ "goldAtLeast": 10 }],
      "effects": [{ "op": "payGold", "amount": 10, "pool": "altar" }, { "op": "applyStatus", "status": "blessed" }] },
    { "id": "chapel.desecrate", "room": 3,
      "when": [{ "roomFlag": "desecrated", "is": false }],
      "check": { "ability": "STR", "dc": 12 },
      "onSuccess": [{ "op": "setRoomFlag", "flag": "desecrated" }, { "op": "claimPool", "pool": "altar" },
                    { "op": "grantLoot", "table": "chapel_ward" }, { "op": "spawnMonster", "template": "ghoul", "alert": true },
                    { "op": "narrate", "outcome": "the_saints_weep" }],
      "onFailure": [{ "op": "applyStatus", "status": "chilled" }] },

    { "id": "scriptorium.pick_lock", "room": 4,
      "when": [{ "roomFlag": "chest_open", "is": false }],
      "check": { "ability": "DEX", "dc": 14, "advantageIf": [{ "class": "rogue" }, { "hasItem": "lockpicks" }] },
      "onSuccess": [{ "op": "setRoomFlag", "flag": "chest_open" }, { "op": "grantLoot", "table": "scriptorium_chest" }],
      "onFailure": [{ "op": "narrate", "outcome": "lock_jams" }] },
    { "id": "scriptorium.smash", "room": 4,
      "when": [{ "roomFlag": "chest_open", "is": false }],
      "check": { "ability": "STR", "dc": 16 },
      "effects": [{ "op": "spawnMonster", "template": "giant_rat", "room": 5 }, { "op": "spawnMonster", "template": "skeleton", "room": 2 },
                  { "op": "narrate", "outcome": "noise_carries" }],
      "onSuccess": [{ "op": "setRoomFlag", "flag": "chest_open" }, { "op": "grantLoot", "table": "scriptorium_chest" }],
      "onFailure": [{ "op": "narrate", "outcome": "chest_holds" }] },
    { "id": "scriptorium.read_tome", "room": 4,
      "when": [{ "charFlag": "tome_lore", "is": false }],
      "check": { "ability": "INT", "dc": 12 },
      "onSuccess": [{ "op": "setCharFlag", "flag": "tome_lore" }],
      "onFailure": [{ "op": "narrate", "outcome": "pages_crumble" }] },

    { "id": "cloister.clear_rubble", "room": 5,
      "when": [{ "roomCounter": "rubble", "below": 2 }],
      "check": { "ability": "STR", "dc": 12 },
      "onSuccess": [{ "op": "incRoomCounter", "counter": "rubble" }],
      "onFailure": [{ "op": "narrate", "outcome": "rubble_shifts" }] },

    { "id": "bell.spot", "room": 6, "provokes": false,
      "when": [{ "roomFlag": "trap_spotted", "is": false }, { "roomFlag": "trap_disarmed", "is": false }, { "roomFlag": "trap_triggered", "is": false }],
      "check": { "ability": "WIS", "dc": 13, "advantageIf": [{ "class": "rogue" }] },
      "onSuccess": [{ "op": "setRoomFlag", "flag": "trap_spotted" }],
      "onFailure": [{ "op": "narrate", "outcome": "nothing_seen" }] },
    { "id": "bell.disarm", "room": 6, "provokes": false,
      "when": [{ "roomFlag": "trap_spotted" }, { "roomFlag": "trap_disarmed", "is": false }, { "roomFlag": "trap_triggered", "is": false }],
      "check": { "ability": "DEX", "dc": 13, "advantageIf": [{ "class": "rogue" }] },
      "onSuccess": [{ "op": "setRoomFlag", "flag": "trap_disarmed" }],
      "onFailure": [{ "op": "setRoomFlag", "flag": "trap_triggered" }, { "op": "alertMonsters", "room": 11 }, { "op": "narrate", "outcome": "bell_tolls" },
                    { "op": "damage", "dice": "2d6", "save": { "ability": "DEX", "dc": 13, "half": false } }] },
    { "id": "bell.walk_blind", "room": 6, "provokes": false,
      "when": [{ "roomFlag": "trap_disarmed", "is": false }, { "roomFlag": "trap_triggered", "is": false }],
      "check": { "ability": "DEX", "dc": 13, "save": true },
      "effects": [{ "op": "setRoomFlag", "flag": "trap_triggered" }, { "op": "alertMonsters", "room": 11 }, { "op": "narrate", "outcome": "bell_tolls" }],
      "onSuccess": [{ "op": "moveTo", "room": 7 }],
      "onFailure": [{ "op": "damage", "dice": "2d6" }, { "op": "moveTo", "room": 7 }] },

    { "id": "reliquary.investigate", "room": 7, "provokes": false,
      "when": [{ "monsterStatus": { "template": "mimic", "status": "disguised" } }],
      "check": { "ability": "INT", "dc": 14 },
      "onSuccess": [{ "op": "setMonsters", "template": "mimic", "status": "hostile" }, { "op": "applyStatus", "status": "emboldened" },
                    { "op": "narrate", "outcome": "coffer_breathes" }],
      "onFailure": [{ "op": "narrate", "outcome": "just_a_coffer" }] },
    { "id": "reliquary.open_coffer", "room": 7, "provokes": false,
      "when": [{ "monsterStatus": { "template": "mimic", "status": "disguised" } }],
      "effects": [{ "op": "setMonsters", "template": "mimic", "status": "hostile" }, { "op": "narrate", "outcome": "coffer_bites" },
                  { "op": "monsterAttack", "advantage": true }] },
    { "id": "reliquary.search_walls", "room": 7,
      "when": [{ "roomFlag": "revealed:10", "is": false }],
      "check": { "ability": "WIS", "dc": 15, "autoSuccessIf": [{ "charFlag": "tome_lore" }] },
      "onSuccess": [{ "op": "revealEdge", "to": 10 }, { "op": "narrate", "outcome": "chalk_mark" }],
      "onFailure": [{ "op": "narrate", "outcome": "cold_stone" }] },

    { "id": "kitchens.parley", "room": 8,
      "when": [{ "monsterStatus": { "template": "goblin", "status": "wary" } }],
      "check": { "ability": "CHA", "dc": 12 },
      "onSuccess": [{ "op": "setMonsters", "template": "goblin", "status": "friendly" }, { "op": "setCharFlag", "flag": "bridge_warning" },
                    { "op": "narrate", "outcome": "goblins_deal" }],
      "onFailure": [{ "op": "setMonsters", "template": "goblin", "status": "hostile" }] },
    { "id": "kitchens.intimidate", "room": 8,
      "when": [{ "any": [{ "monsterStatus": { "template": "goblin", "status": "wary" } }, { "monsterStatus": { "template": "goblin", "status": "hostile" } }] }],
      "check": { "ability": ["STR", "CHA"], "dc": 14 },
      "onSuccess": [{ "op": "setMonsters", "template": "goblin", "status": "fled" }, { "op": "narrate", "outcome": "goblins_scatter" }],
      "onFailure": [{ "op": "setMonsters", "template": "goblin", "status": "hostile" }] },
    { "id": "kitchens.buy_potion", "room": 8,
      "when": [{ "monsterStatus": { "template": "goblin", "status": "friendly" } }, { "goldAtLeast": 20 }, { "roomCounter": "potion_sold", "below": 1 }],
      "effects": [{ "op": "payGold", "amount": 20 }, { "op": "grantItem", "item": "healing_potion" }, { "op": "incRoomCounter", "counter": "potion_sold" }] },

    { "id": "bridge.cross", "room": 9, "provokes": false,
      "when": [{ "roomFlag": "rope_tied", "is": false }],
      "check": { "ability": "DEX", "dc": 12, "advantageIf": [{ "charFlag": "bridge_warning" }] },
      "onSuccess": [{ "op": "moveTo", "room": 11 }],
      "onFailure": [{ "op": "damage", "dice": "1d6" }, { "op": "narrate", "outcome": "swept_away" }, { "op": "moveTo", "room": 1 }] },
    { "id": "bridge.use_rope", "room": 9, "provokes": false,
      "when": [{ "roomFlag": "rope_tied", "is": false }, { "hasItem": "rope" }],
      "effects": [{ "op": "moveTo", "room": 11 }] },
    { "id": "bridge.tie_rope", "room": 9, "provokes": false,
      "when": [{ "roomFlag": "rope_tied", "is": false }, { "hasItem": "rope" }],
      "check": { "ability": "STR", "dc": 10 },
      "onSuccess": [{ "op": "consumeItem", "item": "rope" }, { "op": "setRoomFlag", "flag": "rope_tied" }],
      "onFailure": [{ "op": "narrate", "outcome": "knot_slips" }] },

    { "id": "sacristy.loot", "room": 10,
      "when": [{ "lootAvailable": "sacristy_hoard" }],
      "effects": [{ "op": "grantLoot", "table": "sacristy_hoard" }] },

    { "id": "choir.sneak", "room": 11, "provokes": "onFailure",
      "when": [{ "monstersAlive": true }],
      "check": { "ability": "DEX", "dc": 15 },
      "onSuccess": [{ "op": "moveTo", "room": 12 }],
      "onFailure": [{ "op": "narrate", "outcome": "choir_turns" }] },

    { "id": "sepulchre.present_signet", "room": 12,
      "when": [{ "hasItem": "abbots_signet" }, { "monstersAlive": true }, { "roomFlag": "signet_presented", "is": false }],
      "check": { "ability": "CHA", "dc": 15 },
      "onSuccess": [{ "op": "setRoomFlag", "flag": "signet_presented" }, { "op": "applyStatus", "status": "emboldened", "charges": 2, "target": "room" },
                    { "op": "narrate", "outcome": "abbot_hesitates" }],
      "onFailure": [{ "op": "narrate", "outcome": "abbot_scorns" }] }
  ]
}
